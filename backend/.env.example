# 数据库配置
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=sailtrack
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# 邮件服务配置
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your_email@163.com
MAIL_PASSWORD=your_email_auth_code

# 阿里云配置
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_OSS_BUCKET_NAME=your_oss_bucket_name
ALIYUN_OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
ALIYUN_FACEBODY_ENDPOINT=facebody.cn-shanghai.aliyuncs.com

# 人脸识别配置
FACE_RECOGNITION_THRESHOLD=80.0

# JWT配置
JWT_SECRET=your_jwt_secret_key_at_least_32_characters
JWT_EXPIRATION=3600000
